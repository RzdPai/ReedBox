    // 在 Linux 构建机上会 Install 到不存在的目录 ⇒ 00308003 workspace/node_modules 里找不到 hvigor.js。
    // 需要恢复 Windows 直连入口时把这两行填回去即可(见 RzdDocs/memory/全局记忆.md「克隆第三方工程」那条)。
  },
  "properties": {
    "hvigor.dependency.useNpm": false,
    "ohos.pack.compressLevel": "standard"
  },
